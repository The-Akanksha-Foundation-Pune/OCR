# Copy to .env and fill in. Never commit the filled-in .env.

# ---- MySQL (active_student_data, employees, ocr_scan_log) ----
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_USER=
DB_PASS=
DB_NAME=
DB_PORT=3306

# ---- Flask ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ---- Google OAuth2 (Cloud Console > APIs & Services > Credentials) ----
# Register the callback for EVERY host the app runs on, e.g.
#   http://127.0.0.1:5000/login/google/callback
#   https://ocr.akanksha.org/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Access control ----
ALLOWED_EMAIL_DOMAIN=akanksha.org
# Matched against the employees table; either one is enough to get in.
ALLOWED_SCHOOL_ACRONYMS=
ALLOWED_DESIGNATIONS=

# ---- Google Drive (scanned uploads land here) ----
DRIVE_OCR_FOLDER_NAME=OCR

# ---- Cloud Vision (reads the cropped Student ID field) ----
# Path to the service-account JSON. Keep it outside the repo or under secrets/.
GOOGLE_VISION_CREDENTIALS=secrets/your-service-account.json
VISION_ENABLED=1

# ---- Tuning ----
FAST_MODE=1

# ---- Scan queue ----
# Scanned pages wait here for OCR, then for a person to confirm each document.
# Relative paths are from the repository root. Defaults to data/queue.
QUEUE_DIR=
# Who reads the queue. Leave unset: run.py (debug) reads it in a thread of its
# own, and in production the inbox watcher does (python -m server.inbox_watcher).
# 1 forces a reader thread into this web app, 0 forbids one. Never 1 under
# gunicorn - every worker would start its own.
OCR_WORKER_IN_PROCESS=
# How long confirmed and uploaded documents stay listed on the scan page.
DONE_DOCUMENTS_HOURS=72

# ---- Tether SSO ----
# Must equal JWT_SECRET in the Tether server .env. Tether signs a 10-minute
# token and appends it as ?token=; leaving this unset disables SSO entirely.
INTEGRATION_JWT_SECRET=
